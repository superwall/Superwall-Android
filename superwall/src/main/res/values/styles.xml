<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Survey -->
    <style name="TitleTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#000000</item>
    </style>
    <style name="MessageTextStyle">
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Customer Center. A host app can restyle it by overriding this style. -->
    <style name="Theme.Superwall.CustomerCenter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/superwall_customer_center_background</item>
        <item name="android:statusBarColor">@color/superwall_customer_center_background</item>
        <item name="android:navigationBarColor">@color/superwall_customer_center_background</item>
    </style>
</resources>